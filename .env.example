# Salin menjadi .env.local lalu isi nilainya. Jangan commit .env.local.

# --- Publik (boleh terlihat di browser; dilindungi RLS) ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Khusus server (JANGAN diberi awalan NEXT_PUBLIC_) ---
# Service role key melewati RLS. Dipakai hanya oleh script seed dan aksi
# server khusus Pemilik (mis. membuat akun pengguna).
SUPABASE_SERVICE_ROLE_KEY=

# Password untuk seluruh akun demo yang dibuat `npm run seed:akun` (min. 8 karakter).
DEMO_PASSWORD=
