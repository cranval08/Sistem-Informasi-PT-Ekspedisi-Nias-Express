# Salin menjadi .env.local lalu isi nilainya. Jangan commit .env.local.
# Periksa tanpa menampilkan nilai: npm run cek:env

# --- Publik (boleh terlihat di browser; dilindungi RLS) ---
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...).
# Nama lama NEXT_PUBLIC_SUPABASE_ANON_KEY masih diterima sebagai cadangan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Khusus server: JANGAN PERNAH diberi awalan NEXT_PUBLIC_ ---
# Secret key (sb_secret_...): melewati RLS. Dipakai hanya oleh script
# seed dan aksi server khusus Pemilik. Nama lama SUPABASE_SERVICE_ROLE_KEY
# masih diterima sebagai cadangan.
SUPABASE_SECRET_KEY=

# Password untuk seluruh akun demo yang dibuat `npm run seed:akun` (min. 8 karakter).
DEMO_PASSWORD=
